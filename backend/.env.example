# ─── BookNSmash Backend Environment ──────────────────────────
# Copy this file to .env and fill in the values.

# Server Configuration
# PORT: Preferred port. If occupied, the server auto-selects
# the next available port in the 5000–5010 range.
PORT=5000
NODE_ENV=development

# JWT Secrets (CHANGE IN PRODUCTION — use long random strings)
JWT_SECRET=your-secret-key-change-in-production-use-long-random-string
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production-use-different-long-random-string

# CORS Origin (your frontend URL)
CORS_ORIGIN=http://localhost:5173

# Database Connection
DATABASE_URL=
DIRECT_URL=
